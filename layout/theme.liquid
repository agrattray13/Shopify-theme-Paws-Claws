<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <!-- Extravagant Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- style -%}
      :root {
        --font-body-family: 'Plus Jakarta Sans', sans-serif;
        --font-heading-family: 'Syne', sans-serif;
        --font-accent-family: 'Fredoka', sans-serif;

        --color-bg-primary: {{ settings.color_bg_primary | default: '#0f0c1b' }};
        --color-bg-secondary: {{ settings.color_bg_secondary | default: '#1a1635' }};
        --color-text-primary: {{ settings.color_text_primary | default: '#ffffff' }};
        --color-text-secondary: {{ settings.color_text_secondary | default: '#a9a4d8' }};
        --color-accent-teal: {{ settings.color_accent_teal | default: '#00f2fe' }};
        --color-accent-pink: {{ settings.color_accent_pink | default: '#fe019a' }};
        --color-accent-orange: {{ settings.color_accent_orange | default: '#ff8c00' }};
        --color-accent-purple: {{ settings.color_accent_purple | default: '#7b2cbf' }};
        --color-border: {{ settings.color_border | default: 'rgba(255, 255, 255, 0.1)' }};
      }
    {%- endstyle -%}
  </head>

  <body class="template-{{ template.name }} extravagant-cursor-enabled">
    <!-- Premium Geometric Background Accent Elements -->
    <div class="extravagant-bg-shapes">
      <div class="shape bg-circle-large"></div>
      <div class="shape bg-circle-medium"></div>
      <div class="shape bg-square-rotated"></div>
      <div class="shape bg-rect-diagonal"></div>
      <div class="shape bg-circle-small-dots"></div>
    </div>

    <!-- Custom Cursor -->
    <div class="custom-cursor-follower" id="customCursorFollower"></div>
    <div class="custom-cursor-dot" id="customCursorDot"></div>

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      Skip to content
    </a>

    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
    </script>
  </body>
</html>
