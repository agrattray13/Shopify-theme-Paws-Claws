        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Every stitch tells a story of dedication, precision, and decades of heritage. Our master tailors ensure that every seam, buttonhole, and lapel is executed with absolute perfection, creating a silhouette that is distinctly yours.</p>",
            "text_style": "body"
          }
        },
        "button": {
          "type": "button",
          "settings": {
