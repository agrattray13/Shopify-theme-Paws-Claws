      "type": "multicolumn",
      "blocks": {
        "column_1": {
          "type": "column",
          "settings": {
            "title": "Fine Craftsmanship",
            "text": "<p>Hand-finished details, premium full-canvas structures, and precise hand-rolled stitching defining a class of its own.</p>"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "title": "Exquisite Materials",
            "text": "<p>Sourced from historic Italian and British mills, including the finest Grade-A cashmere, merino wool, and mulberry silk.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "title": "The Perfect Fit",
            "text": "<p>Refined silhouettes tailored meticulously to drape impeccably, moving with effortless elegance and confidence.</p>"
          }
        }
      },
      "block_order": [
        "column_1",
        "column_2",
        "column_3"
      ],
      "settings": {
        "title": "The Pillars of Artesian",
        "heading_size": "h2",
        "image_width": "third",
        "image_ratio": "adapt",
        "columns_desktop": 3,
        "column_alignment": "center",
        "background_style": "none",
        "color_scheme": "scheme-1"
