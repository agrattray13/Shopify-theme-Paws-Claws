<!-- sections/footer.liquid -->
<footer class="bg-slate-900 text-gray-300 pt-16 pb-8 border-t border-slate-800 relative overflow-hidden">
  
  <!-- Decorative background elements -->
  <div class="absolute -top-10 -left-10 text-slate-800 opacity-20 text-9xl pointer-events-none select-none float-animation">
    <i class="fa-solid fa-paw"></i>
  </div>
  <div class="absolute -bottom-10 -right-10 text-slate-800 opacity-20 text-9xl pointer-events-none select-none float-animation-delay">
    <i class="fa-solid fa-bone"></i>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <!-- Column 1: Brand Pitch -->
      <div class="space-y-6">
        <a href="{{ routes.root_url }}" class="flex items-center gap-2 group">
          <div class="w-9 h-9 bg-primary/20 rounded-full flex items-center justify-center text-primary text-lg">
            <i class="fa-solid fa-paw"></i>
          </div>
          <span class="font-heading font-bold text-xl text-white tracking-tight">
            Claws <span class="text-primary">&amp;</span> Paws
          </span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Premium pet food, durable toys, and luxury accessories curated for your beloved dogs and cats. We treat your pets like royalty.
        </p>
        <div class="flex items-center gap-4 text-white text-lg">
          {% if settings.social_instagram != blank %}
            <a href="{{ settings.social_instagram }}" class="hover:text-primary transition-colors duration-200" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          {% endif %}
          {% if settings.social_facebook != blank %}
            <a href="{{ settings.social_facebook }}" class="hover:text-primary transition-colors duration-200" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
          {% endif %}
          {% if settings.social_pinterest != blank %}
            <a href="{{ settings.social_pinterest }}" class="hover:text-primary transition-colors duration-200" aria-label="Pinterest"><i class="fa-brands fa-pinterest"></i></a>
          {% endif %}
          {% if settings.social_twitter != blank %}
            <a href="{{ settings.social_twitter }}" class="hover:text-primary transition-colors duration-200" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
          {% endif %}
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div>
        <h4 class="font-bold text-white text-base mb-6 font-heading tracking-wide border-b border-slate-800 pb-2 flex items-center justify-between">
          <span>Shop &amp; Care</span>
          <i class="fa-solid fa-bone text-xs text-primary"></i>
        </h4>
        <ul class="space-y-3.5 text-sm font-medium">
          <li><a href="{{ routes.all_products_collection_url }}" class="hover:text-primary hover:underline transition-all">All Products</a></li>
          <li><a href="/collections" class="hover:text-primary hover:underline transition-all">Collections Grid</a></li>
          <li><a href="/pages/about" class="hover:text-primary hover:underline transition-all">About Us Story</a></li>
          <li><a href="/blogs/news" class="hover:text-primary hover:underline transition-all">Pet Care Blog</a></li>
        </ul>
      </div>

      <!-- Column 3: Quick Links -->
      <div>
        <h4 class="font-bold text-white text-base mb-6 font-heading tracking-wide border-b border-slate-800 pb-2 flex items-center justify-between">
          <span>Customer Help</span>
          <i class="fa-solid fa-circle-question text-xs text-primary"></i>
        </h4>
        <ul class="space-y-3.5 text-sm font-medium">
          <li><a href="/pages/contact" class="hover:text-primary hover:underline transition-all">Contact Us</a></li>
          <li><a href="/pages/faq" class="hover:text-primary hover:underline transition-all">FAQs</a></li>
          <li><a href="/policies/shipping-policy" class="hover:text-primary hover:underline transition-all">Shipping &amp; Delivery</a></li>
          <li><a href="/policies/refund-policy" class="hover:text-primary hover:underline transition-all">Easy 30-Day Returns</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="space-y-6">
        <h4 class="font-bold text-white text-base font-heading tracking-wide border-b border-slate-800 pb-2 flex items-center justify-between">
          <span>Pet Club Club</span>
          <i class="fa-solid fa-heart text-xs text-primary"></i>
        </h4>
        <p class="text-gray-400 text-sm leading-relaxed">
          Subscribe to get <span class="text-primary font-bold">15% off</span> your first order, plus expert pet training and nutrition guides.
        </p>
        {% form 'customer', class: 'space-y-2' %}
          {% if form.posted_successfully? %}
            <div class="bg-green-800/30 border border-green-500/40 text-green-300 p-3 rounded-xl text-xs">
              🐾 Successfully subscribed! Welcome to the Claws &amp; Paws family.
            </div>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="flex items-center bg-slate-800 rounded-full border border-slate-700 focus-within:border-primary/50 transition-colors p-1">
              <input type="email" name="contact[email]" placeholder="Your email address..." required class="bg-transparent text-sm text-gray-200 placeholder-gray-500 focus:outline-none w-full px-4 py-2">
              <button type="submit" class="bg-primary hover:bg-opacity-90 text-white w-10 h-10 rounded-full flex items-center justify-center transition-all flex-shrink-0" aria-label="Subscribe">
                <i class="fa-solid fa-paper-plane text-xs"></i>
              </button>
            </div>
            {% if form.errors %}
              <p class="text-xs text-red-400 pl-4">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>

    </div>

    <!-- Copyright and Payment badges -->
    <div class="border-t border-slate-800 pt-8 mt-12 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500 font-medium">
        &copy; {{ 'now' | date: '%Y' }} <span class="text-gray-400">{{ shop.name }}</span>. All rights reserved. Built with love for pets.
      </p>
      
      <!-- Payments Badge Grid -->
      <div class="flex items-center gap-2 text-slate-700 text-2xl">
        <i class="fa-brands fa-cc-visa hover:text-gray-400 transition-colors"></i>
        <i class="fa-brands fa-cc-mastercard hover:text-gray-400 transition-colors"></i>
        <i class="fa-brands fa-cc-apple-pay hover:text-gray-400 transition-colors"></i>
        <i class="fa-brands fa-cc-amazon-pay hover:text-gray-400 transition-colors"></i>
        <i class="fa-brands fa-cc-paypal hover:text-gray-400 transition-colors"></i>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
