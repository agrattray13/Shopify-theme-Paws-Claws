<!-- sections/main-product.liquid -->
<section class="py-12 sm:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    {%- if product != blank -%}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        
        <!-- Gallery Column -->
        <div class="space-y-6" data-aos="fade-right">
          <div class="w-full aspect-square rounded-[2rem] overflow-hidden border border-gray-100 bg-gray-50 flex items-center justify-center">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover">
            {%- else -%}
              <div class="text-gray-300 text-7xl"><i class="fa-solid fa-image"></i></div>
            {%- endif -%}
          </div>

          {%- if product.images.size > 1 -%}
            <div class="grid grid-cols-4 gap-4">
              {%- for img in product.images limit: 4 -%}
                <div class="aspect-square rounded-2xl overflow-hidden border border-gray-100 cursor-pointer hover:border-primary transition-all">
                  <img src="{{ img | image_url: width: 200 }}" alt="{{ product.title }}" class="w-full h-full object-cover">
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <!-- Buy Details Column -->
        <div class="space-y-8" data-aos="fade-left" data-aos-delay="200">
          <div class="space-y-2">
            <span class="text-xs text-primary font-bold uppercase tracking-wider">{{ product.vendor | default: "Vet Approved Brands" }}</span>
            <h1 class="text-3xl sm:text-4xl font-black font-heading text-customText leading-tight">{{ product.title }}</h1>
            
            <div class="flex items-center gap-1 text-accent text-sm mt-2">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <span class="text-customTextMuted font-bold ml-1.5">(48 customer reviews)</span>
            </div>
          </div>

          <!-- Price Display -->
          <div class="flex items-baseline gap-4 py-4 border-y border-gray-100">
            <span class="text-3xl font-black text-primary">{{ product.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              <span class="text-lg text-customTextMuted line-through font-medium">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
          </div>

          <!-- Description -->
          <div class="text-sm sm:text-base text-customTextMuted leading-relaxed font-medium">
            {{ product.description }}
          </div>

          <!-- Dynamic AJAX Buy Form -->
          <form action="/cart/add" method="post" enctype="multipart/form-data" class="space-y-6">
            
            <!-- Variants -->
            {%- unless product.has_only_default_variant -%}
              <div class="space-y-3">
                <label class="block text-sm font-bold text-customText">Choose Options</label>
                <div class="relative bg-customBgSec border border-gray-100 rounded-full px-4 py-2.5">
                  <select name="id" class="bg-transparent text-sm font-semibold text-customText w-full focus:outline-none cursor-pointer">
                    {%- for variant in product.variants -%}
                      <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} - {{ variant.price | money }} {% unless variant.available %}(Sold Out){% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              </div>
            {%- else -%}
              <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
            {%- endunless -%}

            <!-- Quantity Selector & Add Button -->
            <div class="flex flex-col sm:flex-row gap-4 items-center">
              <div class="w-full sm:w-32 flex items-center justify-between border border-gray-200 rounded-full px-4 py-3 bg-white">
                <button type="button" onclick="const input = this.nextElementSibling; if(parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;" class="text-customTextMuted hover:text-primary transition-colors px-1 text-sm">
                  <i class="fa-solid fa-minus"></i>
                </button>
                <input type="number" name="quantity" value="1" min="1" class="text-center font-bold text-customText text-sm w-12 bg-transparent focus:outline-none">
                <button type="button" onclick="const input = this.previousElementSibling; input.value = parseInt(input.value) + 1;" class="text-customTextMuted hover:text-primary transition-colors px-1 text-sm">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>

              <button type="submit" class="ajax-add-to-cart-btn w-full bg-primary hover:bg-opacity-90 text-white font-bold py-4 px-8 rounded-full shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2 group">
                <i class="fa-solid fa-cart-shopping"></i>
                <span>{{ 'general.cart.add_to_cart' | t }}</span>
              </button>
            </div>

          </form>

          <!-- Extra Badges -->
          <div class="grid grid-cols-2 gap-4 pt-6 border-t border-gray-100 text-xs font-bold text-customTextMuted">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-shield text-green-500 text-sm"></i> Safe checkout guarantee
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-truck text-secondary text-sm"></i> Free 3-day express shipping
            </div>
          </div>
        </div>

      </div>
    {%- else -%}
      <!-- Fallback Premium Mock Product Detail Page -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        
        <!-- Gallery Column -->
        <div class="space-y-6" data-aos="fade-right">
          <div class="w-full aspect-square rounded-[2rem] overflow-hidden border border-gray-100 bg-blue-50 flex items-center justify-center relative">
            <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#4a90e2_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center text-secondary text-6xl shadow-xl float-animation">
              <i class="fa-solid fa-bone"></i>
            </div>
          </div>
        </div>

        <!-- Buy Details Column -->
        <div class="space-y-8" data-aos="fade-left" data-aos-delay="200">
          <div class="space-y-2">
            <span class="text-xs text-primary font-bold uppercase tracking-wider">Claws &amp; Paws Brand</span>
            <h1 class="text-3xl sm:text-4xl font-black font-heading text-customText leading-tight">Super-Chewer Natural Rubber Bone</h1>
            
            <div class="flex items-center gap-1 text-accent text-sm mt-2">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <span class="text-customTextMuted font-bold ml-1.5">(48 customer reviews)</span>
            </div>
          </div>

          <!-- Price Display -->
          <div class="flex items-baseline gap-4 py-4 border-y border-gray-100">
            <span class="text-3xl font-black text-primary">$19.99</span>
            <span class="text-lg text-customTextMuted line-through font-medium">$29.99</span>
          </div>

          <!-- Description -->
          <div class="text-sm sm:text-base text-customTextMuted leading-relaxed font-medium space-y-4">
            <p>Our flagship chew bone is made from 100% natural, non-toxic food-grade rubber. Tested on aggressive masticators to ensure hours of dental-safe, ultra-durable playtime fun.</p>
            <p>Infused with real bacon scent and ridges designed to massage gums and keep teeth sparkling clean naturally.</p>
          </div>

          <!-- Dynamic AJAX Buy Form Mock -->
          <form action="/cart/add" method="post" class="space-y-6">
            <input type="hidden" name="id" value="1">
            
            <!-- Variants Mock -->
            <div class="space-y-3">
              <label class="block text-sm font-bold text-customText">Choose Color</label>
              <div class="flex gap-3">
                <button type="button" class="px-5 py-2 rounded-full border-2 border-primary text-primary font-bold text-xs">Ruby Coral</button>
                <button type="button" class="px-5 py-2 rounded-full border border-gray-200 hover:border-primary hover:text-primary transition-all text-customText font-bold text-xs">Sapphire Blue</button>
                <button type="button" class="px-5 py-2 rounded-full border border-gray-200 hover:border-primary hover:text-primary transition-all text-customText font-bold text-xs">Emerald Green</button>
              </div>
            </div>

            <!-- Quantity Selector & Add Button -->
            <div class="flex flex-col sm:flex-row gap-4 items-center">
              <div class="w-full sm:w-32 flex items-center justify-between border border-gray-200 rounded-full px-4 py-3 bg-white">
                <button type="button" onclick="const input = this.nextElementSibling; if(parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;" class="text-customTextMuted hover:text-primary transition-colors px-1 text-sm">
                  <i class="fa-solid fa-minus"></i>
                </button>
                <input type="number" name="quantity" value="1" min="1" class="text-center font-bold text-customText text-sm w-12 bg-transparent focus:outline-none">
                <button type="button" onclick="const input = this.previousElementSibling; input.value = parseInt(input.value) + 1;" class="text-customTextMuted hover:text-primary transition-colors px-1 text-sm">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>

              <button type="submit" class="ajax-add-to-cart-btn w-full bg-primary hover:bg-opacity-90 text-white font-bold py-4 px-8 rounded-full shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2 group">
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Add to Cart</span>
              </button>
            </div>

          </form>

          <!-- Extra Badges -->
          <div class="grid grid-cols-2 gap-4 pt-6 border-t border-gray-100 text-xs font-bold text-customTextMuted">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-shield text-green-500 text-sm"></i> Safe checkout guarantee
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-truck text-secondary text-sm"></i> Free 3-day express shipping
            </div>
          </div>
        </div>

      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
