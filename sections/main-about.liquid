<!-- sections/main-about.liquid -->
<!-- About Us Header Hero -->
<section class="bg-customBgSec py-16 sm:py-24 border-b border-gray-100 overflow-hidden relative">
  <!-- floating elements -->
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
    <div class="absolute top-10 left-10 text-primary text-8xl float-animation"><i class="fa-solid fa-paw"></i></div>
    <div class="absolute bottom-10 right-10 text-secondary text-9xl float-animation-delay"><i class="fa-solid fa-bone"></i></div>
  </div>

  <div class="max-w-4xl mx-auto px-6 text-center relative z-10 space-y-6">
    <div class="inline-flex items-center gap-1.5 text-primary text-xs font-bold uppercase tracking-wider bg-primary/10 py-1.5 px-4 rounded-full" data-aos="fade-down">
      <i class="fa-solid fa-heart"></i> Our Founding Story
    </div>
    <h1 class="text-4xl sm:text-6xl font-black font-heading text-customText leading-tight" data-aos="fade-up" data-aos-delay="100">
      Built by Pet Lovers, <br>
      <span class="text-primary relative inline-block">
        For Pet Lovers
        <span class="absolute left-0 bottom-1 w-full h-2 bg-accent/30 rounded-full -z-10"></span>
      </span>
    </h1>
    <p class="text-base sm:text-xl text-customTextMuted font-semibold leading-relaxed max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="200">
      At Claws &amp; Paws, we believe pets are family. That's why we dedicated ourselves to curating elite wellness supplies that help dogs and cats live longer, happier, and more vibrant lives.
    </p>
  </div>
</section>

<!-- Values Count Grid -->
<section class="py-12 bg-white relative z-20 -mt-10 max-w-5xl mx-auto px-6">
  <div class="bg-slate-900 text-white rounded-[3rem] p-8 sm:p-12 shadow-2xl grid grid-cols-1 sm:grid-cols-3 gap-8 text-center" data-aos="zoom-in">
    <div class="space-y-1 border-b sm:border-b-0 sm:border-r border-slate-800 pb-6 sm:pb-0">
      <p class="text-4xl sm:text-5xl font-black font-heading text-primary">12k+</p>
      <p class="text-xs sm:text-sm font-semibold text-gray-400 uppercase tracking-widest">Happy Tail Wags</p>
    </div>
    <div class="space-y-1 border-b sm:border-b-0 sm:border-r border-slate-800 pb-6 sm:pb-0">
      <p class="text-4xl sm:text-5xl font-black font-heading text-accent">100%</p>
      <p class="text-xs sm:text-sm font-semibold text-gray-400 uppercase tracking-widest">Vet-Approved Raw Foods</p>
    </div>
    <div class="space-y-1">
      <p class="text-4xl sm:text-5xl font-black font-heading text-secondary">24/7</p>
      <p class="text-xs sm:text-sm font-semibold text-gray-400 uppercase tracking-widest">Expert Care Support</p>
    </div>
  </div>
</section>

<!-- Founding Narrative -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    
    <!-- Image block -->
    <div class="relative" data-aos="fade-right">
      <div class="absolute w-[95%] h-[95%] bg-accent/10 rounded-[3rem] -z-10 -bottom-4 -left-4 transform rotate-2"></div>
      <div class="rounded-[3rem] overflow-hidden shadow-2xl border-4 border-white bg-blue-50 aspect-[4/3] flex items-center justify-center relative">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#4a90e2_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center text-primary text-6xl shadow-xl float-animation">
          <i class="fa-solid fa-shield-cat"></i>
        </div>
      </div>
    </div>

    <!-- Text block -->
    <div class="space-y-8" data-aos="fade-left">
      <div class="inline-flex items-center gap-1.5 text-secondary text-sm font-bold uppercase tracking-wider">
        <i class="fa-solid fa-compass"></i> Our Ultimate Journey
      </div>
      <h2 class="text-3xl sm:text-4xl font-black font-heading text-customText">
        How a Tiny Kitten Sparked a Global Pet Supplies Mission
      </h2>
      <p class="text-base text-customTextMuted font-medium leading-relaxed">
        Our story started in 2021 when our founder rescued a tiny, malnourished orange kitten named Oliver. Frustrated by the lack of transparency in grocery store kibble, we began collaborating with local veterinarians to mix nutrient-rich organic treats and orthopedic bedding at home.
      </p>
      <p class="text-base text-customTextMuted font-medium leading-relaxed">
        Today, Claws &amp; Paws supplies premium nutrition formulas and sturdy toys to thousands of homes across the continent. While we've grown, Oliver is still our Chief Quality Officer, testing every toy for chew-durability and fun!
      </p>
    </div>

  </div>
</section>

<!-- Team Section -->
<section class="py-20 bg-customBgSec border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
      <div class="flex items-center justify-center gap-1.5 text-primary text-sm font-bold uppercase tracking-wider" data-aos="fade-up">
        <i class="fa-solid fa-users"></i> Meet the Leaders
      </div>
      <h2 class="text-3xl sm:text-4xl font-black font-heading text-customText" data-aos="fade-up" data-aos-delay="100">
        Our Certified <span class="text-primary">Pet Experts</span>
      </h2>
      <p class="text-customTextMuted font-medium" data-aos="fade-up" data-aos-delay="200">
        Our team consists of passionate animal advocates, professional dog behaviorists, and experienced clinical veterinary nutritionists.
      </p>
    </div>

    <!-- Team Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Member 1 -->
      <div class="group bg-white rounded-3xl overflow-hidden border border-gray-100 p-6 text-center hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="100">
        <div class="w-24 h-24 rounded-full bg-orange-100 text-primary mx-auto mb-6 flex items-center justify-center text-4xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-user-tie"></i>
        </div>
        <h3 class="font-heading font-black text-lg text-customText">Marcus Peterson</h3>
        <p class="text-xs text-primary font-bold mt-1 uppercase tracking-wider">Founder &amp; CEO</p>
        <p class="text-xs text-customTextMuted font-medium mt-3 leading-relaxed">Rescuer, pet nutritionist blogger, and proud dad of Oliver the Cat and Buddy the Retriever.</p>
      </div>

      <!-- Member 2 -->
      <div class="group bg-white rounded-3xl overflow-hidden border border-gray-100 p-6 text-center hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="200">
        <div class="w-24 h-24 rounded-full bg-blue-100 text-secondary mx-auto mb-6 flex items-center justify-center text-4xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-user-doctor"></i>
        </div>
        <h3 class="font-heading font-black text-lg text-customText">Dr. Evelyn Ross</h3>
        <p class="text-xs text-secondary font-bold mt-1 uppercase tracking-wider">Veterinary Director</p>
        <p class="text-xs text-customTextMuted font-medium mt-3 leading-relaxed">Has over 14 years of clinical medicine experience, ensuring all formulas meet strict nutritional guidelines.</p>
      </div>

      <!-- Member 3 -->
      <div class="group bg-white rounded-3xl overflow-hidden border border-gray-100 p-6 text-center hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="300">
        <div class="w-24 h-24 rounded-full bg-amber-100 text-accent mx-auto mb-6 flex items-center justify-center text-4xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-dog"></i>
        </div>
        <h3 class="font-heading font-black text-lg text-customText">Jacob Cole</h3>
        <p class="text-xs text-accent font-bold mt-1 uppercase tracking-wider">Behavior Trainer</p>
        <p class="text-xs text-customTextMuted font-medium mt-3 leading-relaxed">Certified Dog behaviorist with deep expertise in puppy crating, socialization, and separation anxiety.</p>
      </div>

      <!-- Member 4 -->
      <div class="group bg-white rounded-3xl overflow-hidden border border-gray-100 p-6 text-center hover:shadow-xl transition-all duration-300" data-aos="fade-up" data-aos-delay="400">
        <div class="w-24 h-24 rounded-full bg-emerald-100 text-emerald-500 mx-auto mb-6 flex items-center justify-center text-4xl group-hover:scale-110 transition-transform">
          <i class="fa-solid fa-paw"></i>
        </div>
        <h3 class="font-heading font-black text-lg text-customText">Oliver</h3>
        <p class="text-xs text-emerald-600 font-bold mt-1 uppercase tracking-wider">Quality Officer 🐾</p>
        <p class="text-xs text-customTextMuted font-medium mt-3 leading-relaxed">Rescued kitten, master of sleep studies, and ultimate testing authority for squeakers and catnip.</p>
      </div>

    </div>

  </div>
</section>

