<!-- sections/main-cart.liquid -->
<section class="py-16 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Title -->
    <div class="mb-12 border-b border-gray-100 pb-6 flex items-center justify-between">
      <h1 class="text-3xl sm:text-4xl font-black font-heading text-customText flex items-center gap-3">
        <i class="fa-solid fa-shopping-basket text-primary animate-bounce"></i> {{ 'general.cart.title' | t }}
      </h1>
      <a href="{{ routes.all_products_collection_url }}" class="text-sm font-bold text-primary hover:underline flex items-center gap-1">
        <i class="fa-solid fa-arrow-left text-[10px]"></i> Keep Shopping
      </a>
    </div>

    <!-- Layout Columns -->
    <div id="MainCartContainer">
      {%- if cart.item_count == 0 -%}
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center py-20 text-center space-y-6">
          <div class="w-24 h-24 bg-orange-50 rounded-full flex items-center justify-center text-primary text-4xl shadow-inner float-animation">
            <i class="fa-solid fa-cart-shopping"></i>
          </div>
          <div class="space-y-2">
            <h2 class="text-2xl font-bold font-heading text-customText">{{ 'general.cart.empty' | t }}</h2>
            <p class="text-sm text-customTextMuted font-medium">Add some nutritious foods or premium toys to get started!</p>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="bg-primary hover:bg-opacity-90 text-white font-bold py-4 px-8 rounded-full shadow-lg hover:shadow-xl transition-all">
            {{ 'general.cart.continue_shopping' | t }}
          </a>
        </div>
      {%- else -%}
        <!-- Populated Cart -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
          
          <!-- Table/Items Grid -->
          <div class="lg:col-span-2 space-y-6">
            <form action="{{ routes.cart_url }}" method="post" id="CartForm">
              <div class="divide-y divide-gray-100">
                {%- for item in cart.items -%}
                  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between py-6 gap-6">
                    
                    <!-- Details & Image -->
                    <div class="flex items-center gap-6">
                      <div class="w-20 h-20 rounded-2xl overflow-hidden bg-gray-50 border border-gray-100 flex-shrink-0">
                        {%- if item.image -%}
                          <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
                        {%- else -%}
                          <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-300 text-2xl"><i class="fa-solid fa-image"></i></div>
                        {%- endif -%}
                      </div>
                      
                      <div>
                        <h3 class="font-heading font-black text-base text-customText hover:text-primary transition-colors">
                          <a href="{{ item.url }}">{{ item.product.title }}</a>
                        </h3>
                        {%- unless item.product.has_only_default_variant -%}
                          <p class="text-xs text-customTextMuted mt-1 font-semibold">{{ item.variant.title }}</p>
                        {%- endunless -%}
                        <p class="text-xs text-primary font-bold mt-1">{{ item.final_price | money }} each</p>
                      </div>
                    </div>

                    <!-- Quantity Control -->
                    <div class="flex items-center gap-8 justify-between w-full sm:w-auto">
                      <div class="flex items-center border border-gray-200 rounded-full px-3 py-1.5 bg-white shadow-sm">
                        <button type="submit" name="updates[]" value="{{ item.quantity | minus: 1 }}" class="text-customTextMuted hover:text-primary transition-colors px-1 text-sm">
                          <i class="fa-solid fa-minus"></i>
                        </button>
                        <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="text-center font-bold text-customText text-sm w-10 bg-transparent focus:outline-none">
                        <button type="submit" name="updates[]" value="{{ item.quantity | plus: 1 }}" class="text-customTextMuted hover:text-primary transition-colors px-1 text-sm">
                          <i class="fa-solid fa-plus"></i>
                        </button>
                      </div>

                      <div class="text-right">
                        <p class="font-black text-customText text-base">{{ item.final_line_price | money }}</p>
                        <a href="{{ item.url_to_remove }}" class="text-xs font-bold text-red-500 hover:underline mt-1 inline-block">Remove</a>
                      </div>
                    </div>

                  </div>
                {%- endfor -%}
              </div>
            </form>
          </div>

          <!-- Summary Summary Panel -->
          <div class="bg-customBgSec border border-gray-100 rounded-[2.5rem] p-8 space-y-6 shadow-sm">
            <h3 class="font-heading font-black text-xl text-customText pb-4 border-b border-gray-200/60">Order Summary</h3>
            
            <div class="space-y-4">
              <div class="flex items-center justify-between text-sm font-semibold text-customTextMuted">
                <span>Subtotal</span>
                <span class="text-customText font-bold text-lg">{{ cart.total_price | money }}</span>
              </div>
              <div class="flex items-center justify-between text-sm font-semibold text-customTextMuted">
                <span>Shipping</span>
                <span class="text-green-500 font-bold">FREE 🚚</span>
              </div>
            </div>

            <div class="border-t border-gray-200/60 pt-6">
              <div class="flex items-center justify-between mb-2">
                <span class="text-base font-black text-customText">Total Amount</span>
                <span class="text-2xl font-black text-primary">{{ cart.total_price | money }}</span>
              </div>
              <p class="text-[10px] text-customTextMuted font-medium leading-relaxed">Tax, shipping, and promotional codes will be checked during checkout.</p>
            </div>

            <div class="pt-2">
              <button type="submit" form="CartForm" name="checkout" class="w-full bg-primary hover:bg-opacity-90 text-white font-bold py-4 rounded-full shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2 group">
                <i class="fa-solid fa-credit-card"></i>
                <span>Proceed to Checkout</span>
              </button>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-gray-100 flex items-center gap-3">
              <i class="fa-solid fa-circle-check text-green-500 text-lg"></i>
              <p class="text-[10px] text-customTextMuted leading-snug font-medium">Your data and payments are secured via bank-level AES 256 Encryption mechanisms.</p>
            </div>
          </div>

        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
