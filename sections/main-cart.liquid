<div class="cart-page section-padding" style="max-width: 1400px; margin: 0 auto;">
  <div class="section-header">
    <span class="section-badge">Your Selection</span>
    <h1 class="section-title">Your Royal Cart</h1>
    <p>Prepare to complete your order of absolute magnificence.</p>
  </div>

  <div style="background: var(--color-bg-secondary); border-radius: 24px; padding: 4rem; border: 1px solid var(--color-border); text-align: center;">
    <div style="font-size: 5rem; margin-bottom: 2rem;">🛒</div>
    <h2 style="margin-bottom: 1.5rem;">Your Cart contains (2) premium articles</h2>
    
    <div style="max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 3rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
        <span style="font-weight: 700;">1x Gold-Weave Dog Collar</span>
        <span style="color: var(--color-accent-teal); font-family: var(--font-accent-family);">$1,450.00</span>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
        <span style="font-weight: 700;">1x Imperial Velvet Lounger</span>
        <span style="color: var(--color-accent-teal); font-family: var(--font-accent-family);">$890.00</span>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.5rem; font-weight: 800; padding-top: 1rem;">
        <span>SUBTOTAL</span>
        <span style="color: var(--color-accent-pink); font-family: var(--font-accent-family);">$2,340.00</span>
      </div>
    </div>

    <div style="display: flex; gap: 1.5rem; justify-content: center;">
      <a href="#" class="btn-secondary interactive-shape">Continue Indulging</a>
      <a href="#" class="btn-primary interactive-shape">Proceed to Checkout</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
